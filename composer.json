{
    "name": "kenny1911/ajax-bundle",
    "description": "Symfony bundle for help creating ajax endpoints",
    "type": "symfony-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Kenny1911",
            "email": "o-muzyka@mail.ru"
        }
    ],
    "minimum-stability": "stable",
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "cs-check": "./tools/php-cs-fixer/php-cs-fixer check",
        "cs-fix": "./tools/php-cs-fixer/php-cs-fixer fix",
        "psalm": "./tools/psalm/vendor/bin/psalm",
        "phpunit": "phpunit",
        "composer-require-checker": "./tools/composer-require-checker/vendor/bin/composer-require-checker check",
        "composer-unused": "./tools/composer-unused/vendor/bin/composer-unused",
        "checks": [
            "@composer validate --strict --no-check-publish",
            "@cs-check",
            "@psalm --no-cache",
            "phpunit",
            "@composer-require-checker",
            "@composer-unused"
        ]
    },
    "require": {
        "php": "8.1.* || 8.2.* || 8.3.* || 8.4.*"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Kenny1911\\AjaxBundle\\": "src/"
        },
        "exclude-from-classmap": [
            "src/Resources/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Kenny1911\\AjaxBundle\\Tests\\": "tests/"
        }
    }
}
